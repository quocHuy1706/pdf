# Sử dụng Gemini API để tạo câu hỏi thật
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_new_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# false: báo lỗi khi Gemini không hoạt động
# true: tự chuyển sang bộ tạo câu hỏi demo khi Gemini gặp lỗi
AI_FALLBACK_TO_TEMPLATE=false

APP_SECRET_KEY=change-this-secret-key
DATABASE_URL=sqlite:///./exam_ai.db
UPLOAD_DIR=uploads
EXPORT_DIR=exports
